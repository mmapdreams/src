/* SPDX-License-Identifier: ISC
 *
 * scratch.def -- canonical scratch-domain native status rows.
 * Define CFS_ERROR_STATUS_OK and CFS_ERROR_STATUS_NEGATIVE before inclusion.
 * Negative rows carry native value, POSIX presentation, and documentation.
 */

#ifndef CFS_ERROR_STATUS_OK
#error "define CFS_ERROR_STATUS_OK before including scratch.def"
#endif
#ifndef CFS_ERROR_STATUS_NEGATIVE
#error "define CFS_ERROR_STATUS_NEGATIVE before including scratch.def"
#endif

CFS_ERROR_STATUS_OK(CFS_SCRATCH_OK, 0)
CFS_ERROR_STATUS_NEGATIVE(CFS_SCRATCH_EINVAL, -1, CFS_ERROR_POSIX(EINVAL),
    "Scratch arena or request is invalid.")
CFS_ERROR_STATUS_NEGATIVE(CFS_SCRATCH_EOVERFLOW, -2,
    CFS_ERROR_POSIX(EOVERFLOW),
    "Scratch range arithmetic overflowed.")
CFS_ERROR_STATUS_NEGATIVE(CFS_SCRATCH_ENOSPC, -3, CFS_ERROR_POSIX(ENOMEM),
    "Caller-provided temporary workspace is exhausted.")
